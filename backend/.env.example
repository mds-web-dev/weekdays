# Local development environment settings
# Copy this file to .env for local testing

DEBUG=True
SECRET_KEY=local-dev-secret-key-replace-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS Allowed Origins (comma-separated URLs)
# Add your local Vite dev server and your production Vercel deployment URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Render PostgreSQL connection string (defaults to local SQLite if omitted)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
